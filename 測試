<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>北辰運動管理系統 - 錄影模式</title>
  <style>
    /* 全局樣式重置與背景 */
    body {
      margin: 0;
      padding: 0;
      background-color: #121212;
      color: #ffffff;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      overflow: hidden;
    }

    /* 滿螢幕錄影主容器 */
    .video-fullscreen-container {
      position: relative;
      width: 100vw;
      height: 100vh;
      background-color: #000000;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    /* 視訊畫面：物件填滿整個螢幕，不留黑邊 */
    .webcam-view {
      width: 100%;
      height: 100%;
      object-fit: cover; /* 讓影像完全充滿容器 */
    }

    /* 鏡頭未啟動時的暫位黑色區塊 */
    .video-placeholder {
      position: absolute;
      font-size: 1.2rem;
      color: #ff3333;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      z-index: 1;
    }
    .video-placeholder::before {
      content: "📷";
      font-size: 2.5rem;
    }

    /* ===================================================
       浮疊 UI 元件 (Overlays)
       =================================================== */

    /* 頂部計時器區塊 */
    .timer-overlay {
      position: absolute;
      top: 30px;
      left: 50%;
      transform: translateX(-50%); /* 水平置中 */
      background: rgba(20, 20, 20, 0.85); /* 半透明黑底 */
      backdrop-filter: blur(8px); /* 現代感毛玻璃效果 */
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 12px 32px;
      border-radius: 16px;
      text-align: center;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
      z-index: 10;
      min-width: 120px;
    }

    .timer-seconds {
      display: block;
      font-size: 3.5rem;
      font-weight: 900;
      color: #00ff66; /* 亮綠色秒數 */
      line-height: 1.1;
      font-family: 'Courier New', Courier, monospace; /* 固定寬度字型防止抖動 */
    }

    .timer-status {
      font-size: 0.85rem;
      color: #aaaaaa;
      letter-spacing: 2px;
      margin-top: 4px;
    }

    /* 底部返回計分靶紙按鈕 */
    .btn-return-overlay {
      position: absolute;
      bottom: 40px;
      left: 50%;
      transform: translateX(-50%);
      width: 85%;
      max-width: 400px;
      background: #00ff66;
      color: #000000;
      font-size: 1.1rem;
      font-weight: bold;
      padding: 16px;
      border: none;
      border-radius: 12px;
      cursor: pointer;
      box-shadow: 0 10px 25px rgba(0, 255, 102, 0.3);
      transition: all 0.2s ease;
      z-index: 10;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
    }

    /* 按鈕點擊與懸停動畫 */
    .btn-return-overlay:hover {
      background: #00dd55;
      box-shadow: 0 12px 30px rgba(0, 255, 102, 0.5);
      transform: translateX(-50%) translateY(-2px);
    }

    .btn-return-overlay:active {
      transform: translateX(-50%) translateY(1px);
      box-shadow: 0 5px 15px rgba(0, 255, 102, 0.3);
    }

    /* 當前趟數標籤 (可選，提供運動員確認當前進度) */
    .round-tag {
      position: absolute;
      top: 30px;
      left: 30px;
      background: rgba(0, 0, 0, 0.6);
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: bold;
      border-left: 4px solid #00ff66;
      z-index: 10;
    }
  </style>
</head>
<body>

  <div class="video-fullscreen-container">
    
    <div class="round-tag">第 1 趟</div>

    <div class="timer-overlay" id="timerContainer">
      <span class="timer-seconds" id="timerSeconds">10</span>
      <span class="timer-status" id="timerStatus">點擊啟動</span>
    </div>

    <video id="webcam" class="webcam-view" autoplay playsinline muted></video>

    <div class="video-placeholder" id="videoPlaceholder">
      <span>鏡頭未啟動</span>
    </div>

    <button class="btn-return-overlay" id="btnReturn">
      🎯 返回計分靶紙
    </button>

  </div>

  <script>
    // 取得 DOM 元件
    const video = document.getElementById('webcam');
    const placeholder = document.getElementById('videoPlaceholder');
    const timerContainer = document.getElementById('timerContainer');
    const timerSeconds = document.getElementById('timerSeconds');
    const timerStatus = document.getElementById('timerStatus');
    const btnReturn = document.getElementById('btnReturn');

    let countdownInterval;
    let isTiming = false;

    // --- 1. 自動啟動視訊鏡頭 ---
    async function initWebcam() {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ 
          video: { 
            facingMode: "environment", // 優先使用後鏡頭（若為手機）
            width: { ideal: 1920 },
            height: { ideal: 1080 }
          }, 
          audio: false 
        });
        video.srcObject = stream;
        
        // 當影片開始播放，隱藏未啟動提示
        video.onloadedmetadata = () => {
          placeholder.style.display = 'none';
        };
      } catch (err) {
        console.error("無法取得視訊鏡頭權限:", err);
        placeholder.innerHTML = "<span>無法取得鏡頭權限</span>";
      }
    }

    // --- 2. 計時器功能邏輯 ---
    timerContainer.addEventListener('click', () => {
      if (isTiming) return; // 執行中則不重複觸發
      
      isTiming = true;
      timerStatus.innerText = "計時中";
      let timeLeft = 10;
      timerSeconds.innerText = timeLeft;

      countdownInterval = setInterval(() => {
        timeLeft--;
        timerSeconds.innerText = timeLeft;

        if (timeLeft <= 0) {
          clearInterval(countdownInterval);
          timerStatus.innerText = "時間到！";
          timerSeconds.innerText = "0";
          isTiming = false;
          
          // 這裡可以觸發自動儲存錄影或通知的邏輯
          alert("計時結束！可點擊返回或重新計時。");
        }
      }, 1000);
    });

    // --- 3. 返回按鈕事件 ---
    btnReturn.addEventListener('click', () => {
      // 停止計時器
      clearInterval(countdownInterval);
      
      // 停止鏡頭串流（釋放相機資源）
      if (video.srcObject) {
        const tracks = video.srcObject.getTracks();
        tracks.forEach(track => track.stop());
      }

      // 執行返回靶紙頁面的邏輯（例如切換 Tabs、秀出舊 Block，或是 window.location）
      alert("正在返回計分靶紙...");
      // 如果是用函數控制切換，可以在這邊呼叫你的主程式切換 function
      // 如：switchPage('scoring');
    });

    // 頁面載入時初始化鏡頭
    window.addEventListener('DOMContentLoaded', initWebcam);
  </script>
</body>
</html>
